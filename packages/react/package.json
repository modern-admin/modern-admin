{
  "name": "@modern-admin/react",
  "version": "0.13.0",
  "description": "React 19 frontend layer for Modern Admin — translation boundary, routing, hooks.",
  "homepage": "https://github.com/modern-admin/modern-admin/tree/main/packages/react#readme",
  "keywords": [
    "modern-admin",
    "admin",
    "admin-panel",
    "admin-dashboard",
    "react",
    "hooks",
    "frontend"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/modern-admin/modern-admin.git",
    "directory": "packages/react"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/clean.ts dist .tsbuildinfo && tsc -p tsconfig.build.json && bun ../../scripts/copy.ts src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@modern-admin/core": "workspace:^",
    "@modern-admin/i18n": "workspace:^",
    "@modern-admin/ui": "workspace:^",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "9.3.1",
    "lucide-react": "1.61.0",
    "react-hook-form": "7.90.0",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modern-admin/tsconfig": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
