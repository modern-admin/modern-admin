{
  "name": "{{name}}",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/main.ts",
    "start": "bun run src/main.ts",
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "auth:secret": "bun --print 'Array.from(crypto.getRandomValues(new Uint8Array(32))).map(b => b.toString(16).padStart(2, \"0\")).join(\"\")'"
  },
  "dependencies": {
    "@modern-admin/adapter-prisma": "^{{adapter_prisma_version}}",
    "@modern-admin/api-stock": "^{{api_stock_version}}",
    "@modern-admin/auth-better-auth": "^{{auth_better_auth_version}}",
    "@modern-admin/cache-redis": "^{{cache_redis_version}}",
    "@modern-admin/core": "^{{core_version}}",
    "@modern-admin/nest": "^{{nest_version}}",
    "@modern-admin/system-prisma": "^{{system_prisma_version}}",
    "@modern-admin/web": "^{{web_version}}",
    "@better-auth/api-key": "1.7.18",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "@prisma/internals": "7.10.1",
    "better-auth": "1.7.18",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
