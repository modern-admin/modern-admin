{
  "name": "@modern-admin/web",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": false,
  "description": "Pre-built React admin SPA. Mount it into a host page or let @modern-admin/nest serve the standalone bundle.",
  "homepage": "https://github.com/modern-admin/modern-admin/tree/main/packages/web#readme",
  "keywords": [
    "modern-admin",
    "admin",
    "admin-panel",
    "admin-dashboard",
    "react",
    "spa",
    "vite",
    "frontend"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/modern-admin/modern-admin.git",
    "directory": "packages/web"
  },
  "files": [
    "dist",
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./standalone/*": "./dist/standalone/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "main": "./dist/lib/index.js",
    "types": "./dist/lib/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.js"
      },
      "./vite": {
        "types": "./dist/config/vite.d.ts",
        "default": "./dist/config/vite.js"
      },
      "./standalone/*": "./dist/standalone/*",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode lib && vite build --mode standalone && bun run build:config",
    "build:lib": "vite build --mode lib",
    "build:config": "tsc -p tsconfig.config.json",
    "build:standalone": "vite build --mode standalone",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@modern-admin/core": "workspace:^",
    "@modern-admin/i18n": "workspace:^",
    "@modern-admin/react": "workspace:^",
    "@modern-admin/ui": "workspace:^",
    "@tanstack/react-query": "^5.101.4"
  },
  "devDependencies": {
    "@modern-admin/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/vite": {
      "optional": true
    },
    "@vitejs/plugin-react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
