{
  "name": "modern-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Universal modern admin panel framework",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/modern-admin/modern-admin.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api-prisma dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:start": "scripts/dev.sh start",
    "dev:stop": "scripts/dev.sh stop",
    "dev:restart": "scripts/dev.sh restart",
    "dev:status": "scripts/dev.sh status",
    "build": "bun run --filter '*' build",
    "test": "bun --filter '*' test",
    "e2e": "bun run --cwd apps/e2e e2e",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "changeset": "changeset",
    "version-packages": "changeset version && bun scripts/sync-lock-workspace-versions.ts && bun install --lockfile-only",
    "release": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.4.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "patchedDependencies": {
    "unplugin-dts@1.0.3": "patches/unplugin-dts@1.0.3.patch"
  },
  "overrides": {
    "prosemirror-model": "1.25.11"
  }
}
