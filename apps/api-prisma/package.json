{
  "name": "@modern-admin/app-api-prisma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch run src/main.ts",
    "start": "bun run src/main.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:clean-e2e": "bun run src/clean-e2e.ts",
    "db:clean-e2e:apply": "bun run src/clean-e2e.ts --apply"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.0",
    "@modern-admin/adapter-prisma": "workspace:*",
    "@modern-admin/app-shared": "workspace:*",
    "@modern-admin/auth-better-auth": "workspace:*",
    "@modern-admin/cache-redis": "workspace:*",
    "@modern-admin/core": "workspace:*",
    "@modern-admin/feature-history": "workspace:*",
    "@modern-admin/feature-upload": "workspace:*",
    "@modern-admin/graphql": "workspace:*",
    "@modern-admin/nest": "workspace:*",
    "@modern-admin/queue": "workspace:*",
    "@modern-admin/realtime": "workspace:*",
    "@modern-admin/system-prisma": "workspace:*",
    "@modern-admin/telemetry": "workspace:*",
    "@modern-admin/web": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "@ai-sdk/openai-compatible": "^3.0.35",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@prisma/internals": "^7.9.1",
    "better-auth": "^1.7.0",
    "ai": "^7.0.66",
    "bullmq": "^6.1.2",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "graphql": "^17.0.2",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@modern-admin/tsconfig": "workspace:*",
    "@types/bun": "^1.3.14",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2"
  }
}
