# Postgres connection — used by both Prisma and Better Auth (single source of truth).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/modern_admin

# Where the API listens.
API_PORT=3001
API_HOST=0.0.0.0

# Origin allowed to call /admin/api and /api/auth.
WEB_ORIGIN=http://localhost:3000,http://localhost:5173

# Better Auth public URL (used to build callback links).
AUTH_BASE_URL=http://localhost:3001

# Better Auth signing secret — REQUIRED. Generate with `openssl rand -hex 32`.
# The server refuses to start without a strong (≥32 char) value.
BETTER_AUTH_SECRET=replace-me-with-`openssl rand -hex 32`

SEED_COUNTRIES=false

# Demo admin seeded on first boot.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=admin12345
DEMO_ADMIN_NAME=Demo Admin

# Optional: Redis for cache + realtime.
# REDIS_URL=redis://localhost:6379

# API Stock credential used by both the AI assistant and media generation.
# Create a key at https://api-stock.com and keep it server-side.
# API_STOCK_KEY=

# Public HTTPS origin that API Stock can reach. Do not include /admin/api.
# Leave unset in local development: the server then polls the provider for the
# result instead of expecting a callback. Required in production
# (NODE_ENV=production) — polling is refused there.
# MEDIA_GENERATION_WEBHOOK_BASE_URL=https://admin.example.com

# Required when a webhook base URL is set. Generate with `openssl rand -hex 32`.
# MEDIA_GENERATION_WEBHOOK_SECRET=
# Optional estimated API Stock spend limit per admin and UTC month.
# MEDIA_GENERATION_MONTHLY_BUDGET_USD=100
# Log the model and prompt sent to the provider (server logs only).
# MEDIA_GENERATION_DEBUG=1
